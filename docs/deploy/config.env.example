# /etc/cartrack/config.env
# Owned by root:cartrack, mode 640. Loaded by systemd EnvironmentFile=.
# Do not commit real secrets. Copy to the server and edit in place.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000
DOTNET_EnableDiagnostics=0

# Public SPA / email deep-link base URL (must match the HTTPS site).
AppUrl__FrontendBaseUrl=https://app.example.com

# PostgreSQL (Aspire resource name: cartrack)
ConnectionStrings__cartrack=Host=127.0.0.1;Port=5432;Database=cartrack;Username=cartrack;Password=CHANGE_ME_DB_PASSWORD

# Redis (Aspire resource name: cache)
ConnectionStrings__cache=localhost:6379,password=CHANGE_ME_REDIS_PASSWORD,abortConnect=False

# JWT — Secret must be at least 32 characters.
Jwt__Issuer=CarTrack
Jwt__Audience=CarTrack
Jwt__Secret=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7
Jwt__RefreshTokenRememberMeDays=30

# Optional seed admin (disable or rotate after first boot in production).
SeedAdmin__Username=admin
SeedAdmin__Email=admin@app.example.com
SeedAdmin__Password=CHANGE_ME_ADMIN_PASSWORD
SeedAdmin__DisplayName=System Administrator

# Optional SMTP
Email__Enabled=false
Email__FromAddress=noreply@app.example.com
Email__FromName=CarTrack
Email__SmtpHost=
Email__SmtpPort=587
Email__UseSsl=true
Email__Username=
Email__Password=
